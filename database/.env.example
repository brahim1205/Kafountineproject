PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/kafountine?schema=public
JWT_SECRET=local-dev-jwt-secret-not-for-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-not-for-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
TRUST_PROXY=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379
ENABLE_API_DOCS=true
ENABLE_METRICS=true
METRICS_BEARER_TOKEN=
SEED_DEFAULT_PASSWORD=password123
