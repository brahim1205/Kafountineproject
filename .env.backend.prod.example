POSTGRES_DB=vhm-finances
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TRUST_PROXY=loopback,linklocal,uniquelocal
COOKIE_SAME_SITE=lax

CORS_ORIGIN=https://front.example.com
PORTAL_URL=https://front.example.com

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379
PORTAL_OTP_TTL_SECONDS=600
PORTAL_OTP_DELIVERY_MODE=webhook
PORTAL_OTP_WEBHOOK_URL=https://sms-provider.example.com/send-otp
PORTAL_OTP_WEBHOOK_TOKEN=CHANGE_ME_STRONG_OTP_WEBHOOK_TOKEN

ENABLE_API_DOCS=false
ENABLE_METRICS=false
METRICS_BEARER_TOKEN=CHANGE_ME_STRONG_METRICS_BEARER_TOKEN_MIN_32_CHARS

OTEL_ENABLED=false
OTEL_SERVICE_NAME=kafontine-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

PORT=3000
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/vhm-finances?schema=public&connection_limit=20&pool_timeout=10
