# Production compose variables

POSTGRES_DB=vhm-finances
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/vhm-finances?schema=public&connection_limit=20&pool_timeout=10

JWT_SECRET=change-me-very-strong-secret
JWT_REFRESH_SECRET=change-me-very-strong-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origin(s) autorisées côté backend (séparées par virgules)
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Frontend build-time API URL
VITE_API_URL=/api/v1

# Public domain
TRAEFIK_DOMAIN=your-domain.com
TRAEFIK_WWW_DOMAIN=www.your-domain.com
TRAEFIK_EMAIL=admin@your-domain.com
PORTAL_URL=https://www.your-domain.com

# Host ports for a server already running Nginx on 80/443
FRONT_PORT=8081
BACKEND_PORT=3010
GRAFANA_PORT=3012

# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=kafountine-backend
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://www.your-domain.com/grafana

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379
