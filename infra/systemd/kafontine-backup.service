[Unit]
Description=Verified PostgreSQL backup for Kafontine
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
UMask=0077
# Durées de conservation : voir l'en-tête de scripts/backup-production.sh.
ExecStart=/bin/bash /opt/kafontine/scripts/backup-production.sh /opt/kafontine
TimeoutStartSec=1800
