POSTGRES_DB=vhm-finances-staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_STAGING_POSTGRES_PASSWORD__

JWT_SECRET=__SET_STAGING_JWT_SECRET__
JWT_EXPIRES_IN=12h

CORS_ORIGIN=https://staging.your-domain.com
VITE_API_URL=https://staging-api.your-domain.com/api/v1

FRONT_PORT=5173
BACKEND_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

OTEL_ENABLED=true
OTEL_SERVICE_NAME=kafountine-backend-staging
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__SET_STAGING_GRAFANA_PASSWORD__
GRAFANA_SERVE_FROM_SUB_PATH=false

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=20
