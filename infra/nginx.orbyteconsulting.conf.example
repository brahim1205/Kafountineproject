server {
  listen 80;
  server_name orbyteconsulting.tech www.orbyteconsulting.tech;

  # Redirect HTTP to HTTPS (optional if you handle TLS elsewhere)
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name orbyteconsulting.tech www.orbyteconsulting.tech;

  # Replace with your actual cert paths
  ssl_certificate /etc/letsencrypt/live/orbyteconsulting.tech/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/orbyteconsulting.tech/privkey.pem;

  # API -> backend (docker-compose.prod.yml exposes 127.0.0.1:3010)
  location /api/ {
    proxy_pass http://127.0.0.1:3010;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  # Everything else -> front (docker-compose.prod.yml exposes 127.0.0.1:8081)
  location / {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }
}
