generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nom       String
  prenom    String
  role      String   @default("AGENT")
  telephone String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]
  auditLogs          AuditLog[]
  budgetDemandes     BudgetRequest[] @relation("BudgetRequestRequester")
  budgetApprovals    BudgetRequest[] @relation("BudgetRequestApprover")
  etatCivilRequests  EtatCivilRequest[] @relation("EtatCivilAgent")
  urbanismeCases     UrbanismeCase[] @relation("UrbanismeAgent")
}

model Contribuable {
  id              String   @id @default(uuid())
  nin             String   @unique
  nom             String
  prenom          String
  dateNaiss       DateTime
  lieuNaiss       String
  adresse         String
  telephone       String
  email           String?
  profession      String?
  typeContribuable String  @default("PARTICULIER")
  zone            String?
  montantImpot    Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions      Transaction[]
  etatCivilRequests EtatCivilRequest[]
  urbanismeCases    UrbanismeCase[]
  marketPlaces      MarketPlace[]
  ownedMotos        MotoRegistration[] @relation("MotoOwner")
  drivenMotos       MotoRegistration[] @relation("MotoDriver")
  ownedBoats        FishingBoat[] @relation("FishingBoatOwner")
}

model Transaction {
  id             String       @id @default(uuid())
  numero         String       @unique
  contribuableId String
  agentId        String
  categorie      String
  service        String
  quantite       Int          @default(1)
  tarifUnitaire  Float
  montant        Float
  modePaiement   String       @default("ESPECE")
  statut         String       @default("PAYE")
  date           DateTime     @default(now())
  year           Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contribuable Contribuable @relation(fields: [contribuableId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([year])
}

model BudgetLine {
  id          String   @id @default(uuid())
  code        String
  libelle     String
  description String?
  prevu       Float    @default(0)
  depense     Float    @default(0)
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@unique([code, year])
}

model BudgetRequest {
  id            String   @id @default(uuid())
  service       String
  description   String
  montant       Float
  statut        String   @default("EN_ATTENTE")
  motif         String?
  year          Int
  requestedById String?
  approvedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requestedBy User? @relation("BudgetRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User? @relation("BudgetRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([year])
  @@index([statut])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  role      String
  action    String
  module    String
  details   String
  status    String   @default("success")
  ipAddress String?
  year      Int
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([year])
  @@index([module])
  @@index([status])
  @@index([timestamp])
}

model EtatCivilRequest {
  id             String   @id @default(uuid())
  numero         String   @unique
  contribuableId String
  agentId        String?
  typeDocument   String
  exemplaires    Int      @default(1)
  montant        Float    @default(0)
  statut         String   @default("EN_ATTENTE")
  observations   String?
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contribuable Contribuable @relation(fields: [contribuableId], references: [id], onDelete: Cascade)
  agent        User?        @relation("EtatCivilAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([year])
  @@index([statut])
  @@index([typeDocument])
}

model UrbanismeCase {
  id             String   @id @default(uuid())
  numero         String   @unique
  contribuableId String
  agentId        String?
  type           String
  description    String?
  surface        Float?
  localisation   String?
  nature         String?
  montant        Float    @default(0)
  statut         String   @default("EN_ATTENTE")
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contribuable Contribuable @relation(fields: [contribuableId], references: [id], onDelete: Cascade)
  agent        User?        @relation("UrbanismeAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([year])
  @@index([statut])
  @@index([type])
}

model MarketPlace {
  id              String   @id @default(uuid())
  numeroPlace     String
  type            String
  zone            String
  occupantId      String?
  activite        String?
  telephone       String?
  dateAttribution DateTime?
  tarif           Float    @default(0)
  periode         String   @default("mensuel")
  statut          String   @default("LIBRE")
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  occupant Contribuable?   @relation(fields: [occupantId], references: [id], onDelete: SetNull)
  payments MarketPayment[]

  @@index([year])
  @@index([statut])
  @@unique([numeroPlace, year])
}

model MarketPayment {
  id          String   @id @default(uuid())
  placeId     String
  montant     Float
  reference   String?
  periode     String
  statut      String   @default("PAYE")
  datePaiement DateTime?
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  place MarketPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([year])
  @@index([statut])
}

model MotoRegistration {
  id             String   @id @default(uuid())
  matricule      String   @unique
  marque         String
  modele         String
  annee          Int
  couleur        String?
  proprietaireId String
  conducteurId   String?
  permis         String?  @unique
  statut         String   @default("ACTIVE")
  photo          String?
  enRetard       Boolean  @default(false)
  montantPenalite Float   @default(250)
  prochainPaiement DateTime?
  dernierPaiement  DateTime?
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  proprietaire Contribuable @relation("MotoOwner", fields: [proprietaireId], references: [id], onDelete: Cascade)
  conducteur   Contribuable? @relation("MotoDriver", fields: [conducteurId], references: [id], onDelete: SetNull)
  payments     MotoPayment[]

  @@index([year])
  @@index([statut])
}

model MotoPayment {
  id          String   @id @default(uuid())
  motoId       String
  montant      Float
  reference    String?
  statut       String   @default("PAYE")
  datePaiement DateTime?
  mois         String?
  numeroRecu   String?
  agent        String?
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moto MotoRegistration @relation(fields: [motoId], references: [id], onDelete: Cascade)

  @@index([year])
  @@index([statut])
}

model TrainingProgram {
  id               String   @id @default(uuid())
  nom              String
  domaine          String
  duree            String
  responsable      String
  budget           Float    @default(0)
  dateDebut        DateTime
  dateFin          DateTime
  statut           String   @default("PLANIFIEE")
  year             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments YouthEnrollment[]

  @@index([year])
  @@index([statut])
}

model YouthProfile {
  id           String   @id @default(uuid())
  nom          String
  prenom       String
  cni          String   @unique
  telephone    String   @unique
  adresse      String
  niveauEtude  String
  sexe         String
  dateNaiss    DateTime
  photo        String?
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments YouthEnrollment[]

  @@index([year])
}

model YouthEnrollment {
  id              String   @id @default(uuid())
  jeuneId         String
  formationId     String
  dateInscription DateTime @default(now())
  tauxAssiduite   Float    @default(0)
  statutFinal     String   @default("En cours")
  presences       Int      @default(0)
  absences        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jeune     YouthProfile     @relation(fields: [jeuneId], references: [id], onDelete: Cascade)
  formation TrainingProgram  @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([jeuneId, formationId])
}

model Fisherman {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  telephone String?
  nin       String?
  adresse   String?
  statut    String   @default("ACTIF")
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boats       FishingBoat[]
  commissions FishCommission[]

  @@index([year])
  @@index([statut])
}

model FishingBoat {
  id              String   @id @default(uuid())
  nom             String
  immatriculation String   @unique
  type            String
  taille          Float?
  moteur          String?
  statut          String   @default("ACTIF")
  pecheurId       String?
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pecheur Fisherman? @relation("FishingBoatOwner", fields: [pecheurId], references: [id], onDelete: SetNull)

  @@index([year])
  @@index([statut])
}

model FishCommission {
  id           String   @id @default(uuid())
  numero       String   @unique
  poids        Float
  typePoisson  String
  temperatura  Float?
  observations String?
  statut       String   @default("ENREGISTREE")
  date         DateTime @default(now())
  pecheurId    String
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pecheur Fisherman @relation(fields: [pecheurId], references: [id], onDelete: Cascade)

  @@index([year])
  @@index([statut])
}

model RefrigeratedTruck {
  id              String   @id @default(uuid())
  immatriculation String   @unique
  marque          String
  modele          String?
  capacite        Float?
  chauffeur       String?
  telephone       String?
  statut          String   @default("ACTIF")
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expeditions ShippingExpedition[]

  @@index([year])
  @@index([statut])
}

model ShippingExpedition {
  id           String   @id @default(uuid())
  numero       String   @unique
  date         DateTime @default(now())
  poids        Float
  destination  String?
  montant      Float?
  statut       String   @default("PLANIFIEE")
  observations String?
  camionId     String
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  camion RefrigeratedTruck @relation(fields: [camionId], references: [id], onDelete: Cascade)

  @@index([year])
  @@index([statut])
}

model AppSettingTariff {
  id          String   @id @default(uuid())
  categorie   String
  nom         String
  montant     Float    @default(0)
  unite       String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categorie])
  @@index([actif])
}

model AppSettingPenalty {
  id          String   @id @default(uuid())
  type        String
  description String?
  montant     Float    @default(0)
  delai       String
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([actif])
}

model AppSettingPermission {
  id        String   @id @default(uuid())
  module    String
  role      String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, role])
  @@index([role])
}

model BackupRecord {
  id         String   @id @default(uuid())
  filename   String   @unique
  size       Int      @default(0)
  snapshot   String
  restoredAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model AppNotification {
  id           String   @id @default(uuid())
  userId       String?
  type         String
  titre        String
  message      String
  montant      Float?
  contribuable String?
  agent        String?
  lu           Boolean  @default(false)
  readAt       DateTime?
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year])
  @@index([lu])
  @@index([createdAt])
}
